# Frontend Environment Variables
# Copy this to .env.local for local dev (Vite proxy handles /api automatically)
# Add these as Environment Variables in Vercel dashboard for production

# Your Render backend URL — e.g. https://vsms-api.onrender.com
# Leave empty for local dev (Vite proxy will handle it)
VITE_API_URL=https://your-backend.onrender.com
